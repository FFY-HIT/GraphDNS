{
  "description": "Bounded RFC-oriented DNS configurations for alpha/beta abstraction and binding ablation.",
  "ablation_expectations": {
    "concrete_oracle_is_safe": true,
    "unbound_must_have_false_paths": true,
    "unbound_must_have_false_vulnerabilities": true
  },
  "cases": [
    {
      "id": "dname_concrete_wildcard",
      "description": "A DNAME target contains both an exact address and a wildcard address.",
      "start_server": "ns.s1.test.",
      "start_zone": "s1.test.",
      "authorities": {
        "s1.test.": "ns.s1.test."
      },
      "labels": ["www", "api", "mail", "vpn", "lab", "x", "y", "z"],
      "query_templates": [
        {"suffix": "old.s1.test.", "min_depth": 0, "max_depth": 2}
      ],
      "records": [
        {"id": "s1_dname", "server": "ns.s1.test.", "zone": "s1.test.", "owner": "old.s1.test.", "type": "DNAME", "value": "new.s1.test."},
        {"id": "s1_exact", "server": "ns.s1.test.", "zone": "s1.test.", "owner": "www.new.s1.test.", "type": "A", "value": "192.0.2.1"},
        {"id": "s1_wild", "server": "ns.s1.test.", "zone": "s1.test.", "owner": "*.new.s1.test.", "type": "A", "value": "192.0.2.2"}
      ]
    },
    {
